# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# material de referência (não versionar)
# Downloads da FGV (scripts/baixar-fgv.mjs) servem a um vídeo "Questões que até a FGV errou":
# as diferenças entre gabaritos preliminares e definitivos são a matéria-prima.
/.examples/

# fontes de imagem originais (versionadas em public/img após otimização)

# conteúdo gerado (scripts/build-content.ts)
/src/content/generated/
/public/dados/
/public/downloads/leis/

# cache de coleta (scripts/baixar-leis.ts)
/.cache/

# gerado no build (scripts/gerar-zip-padrao.ts)
/public/downloads/grupos/

# arquivos de apoio do pdf.js, copiados de node_modules pelo build-content
/public/pdfjs/

# prévias de compartilhar geradas (scripts/gerar-previas.ts): uma página e uma imagem por nota e por pontuação
/public/c/

# permissões locais do Claude Code (de cada máquina, não do projeto)
/.claude
/.claude/settings.local.json
AGENTS.md
CLAUDE.md
