{
  "name": "grifo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "preview": "npx --yes serve out -l tcp://${GRIFO_HOST:-100.80.118.27}:${GRIFO_PORT:-3100}",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "node tests/e2e/run.mjs",
    "validar": "node scripts/build-content.ts --check",
    "content": "node scripts/build-content.ts && node scripts/gerar-zip-padrao.ts",
    "previas": "node scripts/gerar-previas.ts",
    "prebuild": "node scripts/build-content.ts && node scripts/gerar-zip-padrao.ts && node scripts/optimize-images.mjs && node scripts/gerar-previas.ts",
    "pdfs": "node scripts/build-pdfs.ts",
    "pdfs:leis": "node scripts/build-pdfs.ts --leis",
    "build:completo": "npm run build && npm run pdfs && npm run pdfs:leis && npm run build",
    "publicar": "bash scripts/publicar.sh",
    "revisar": "node scripts/marcar-revisado.ts",
    "leis": "node scripts/baixar-leis.ts",
    "novo:exame": "node scripts/novo-exame.ts",
    "nova:pergunta": "node scripts/nova-pergunta.ts",
    "novo:jogo": "node scripts/novo-jogo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "parse5": "^8.0.1",
    "patchright": "^1.64.1",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
